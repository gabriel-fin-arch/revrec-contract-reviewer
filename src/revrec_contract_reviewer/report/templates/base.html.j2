<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Contract review{% endblock %}</title>
<style>
  :root {
    --ink: #1b1f23;
    --muted: #5b6570;
    --rule: #d9dde1;
    --panel: #f6f7f8;
    --flag: #8a5a00;
    --flag-bg: #fdf6e6;
    --fail: #a02020;
    --fail-bg: #fbeeee;
    --pass: #1f6b3a;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 2.5rem 1.5rem 4rem;
    font: 15px/1.55 -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: var(--ink);
    background: #fff;
  }
  .sheet { max-width: 860px; margin: 0 auto; }
  h1 { font-size: 1.5rem; margin: 0 0 .2rem; letter-spacing: -.01em; }
  h2 {
    font-size: .78rem; text-transform: uppercase; letter-spacing: .09em;
    color: var(--muted); margin: 2.6rem 0 .9rem;
    border-bottom: 1px solid var(--rule); padding-bottom: .4rem;
  }
  h3 { font-size: 1rem; margin: 0 0 .35rem; }
  .lede { color: var(--muted); margin: 0 0 1.4rem; }
  .meta { display: flex; flex-wrap: wrap; gap: .4rem 1.6rem; font-size: .85rem; color: var(--muted); }
  .meta b { color: var(--ink); font-weight: 600; }
  table { width: 100%; border-collapse: collapse; font-size: .88rem; }
  th, td { text-align: left; padding: .5rem .6rem; border-bottom: 1px solid var(--rule); vertical-align: top; }
  th { font-size: .72rem; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); font-weight: 600; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .tag {
    display: inline-block; font-size: .68rem; text-transform: uppercase; letter-spacing: .06em;
    padding: .12rem .42rem; border-radius: 3px; border: 1px solid var(--rule);
    background: var(--panel); color: var(--muted); white-space: nowrap;
  }
  .tag.extracted { color: var(--pass); border-color: #bcd8c6; background: #f1f8f3; }
  .tag.ambiguous { color: var(--flag); border-color: #e6d3a3; background: var(--flag-bg); }
  .tag.failed    { color: var(--fail); border-color: #e6c3c3; background: var(--fail-bg); }
  .tag.passed    { color: var(--pass); border-color: #bcd8c6; background: #f1f8f3; }
  blockquote {
    margin: .45rem 0 0; padding: .35rem 0 .35rem .8rem;
    border-left: 2px solid var(--rule);
    font-family: Georgia, "Times New Roman", serif; font-size: .85rem; color: #2f353b;
  }
  blockquote cite { display: block; margin-top: .25rem; font-size: .72rem; color: var(--muted); font-style: normal; }
  .flag { border: 1px solid var(--rule); border-left: 3px solid var(--flag); border-radius: 4px;
          padding: 1rem 1.1rem; margin-bottom: .9rem; background: #fffdf8; }
  .flag .step { font-size: .68rem; text-transform: uppercase; letter-spacing: .08em; color: var(--flag); }
  .flag p { margin: .5rem 0 0; font-size: .88rem; }
  .flag .why { color: var(--muted); font-size: .84rem; border-top: 1px dashed var(--rule); padding-top: .55rem; margin-top: .8rem; }
  .absent { color: var(--muted); }
  .empty { color: var(--muted); font-size: .88rem; font-style: italic; }
  footer { margin-top: 3.5rem; padding-top: 1rem; border-top: 1px solid var(--rule);
           font-size: .78rem; color: var(--muted); }
  a { color: inherit; }
  @media print { body { padding: 0; } .flag { break-inside: avoid; } }
</style>
</head>
<body>
<div class="sheet">
{% block body %}{% endblock %}
<footer>
  Generated by revrec-contract-reviewer. Every value above is followed by the contract text it was read
  from. Judgment items are routed to a reviewer by policy and carry no recommended answer.
</footer>
</div>
</body>
</html>
