{% extends "base.html.j2" %}
{% block title %}ASC 606 review -- run index{% endblock %}

{% block body %}
<h1>Contract review</h1>
<p class="lede">
  {{ reviews | length }} contracts reviewed &middot;
  {{ total_flags }} matter{{ '' if total_flags == 1 else 's' }} for judgment &middot;
  {{ total_failed }} failed check{{ '' if total_failed == 1 else 's' }} &middot;
  {{ clean | length }} needing no attention{% if unreadable %} &middot;
  <span class="tag failed">{{ unreadable | length }} could not be read</span>{% endif %}.
</p>

{% if unreadable %}
<h2>Could not be read</h2>
<table>
  <thead><tr><th>File</th><th>Reason</th></tr></thead>
  <tbody>
  {% for name, reason in unreadable %}
  <tr><td>{{ name }}</td><td>{{ reason }}</td></tr>
  {% endfor %}
  </tbody>
</table>
{% endif %}

<h2>Worklist</h2>
<table>
  <thead>
    <tr><th>Contract</th><th>Parties</th><th class="num">Judgments</th><th class="num">Failed</th><th>Extractor</th></tr>
  </thead>
  <tbody>
  {% for review in reviews %}
  <tr>
    <td><a href="{{ review.doc_id }}.html">{{ review.doc_id }}</a></td>
    <td>
      {% if review.extraction.customer.is_known %}{{ review.extraction.customer.value }}{% else %}<span class="absent">unidentified</span>{% endif %}
    </td>
    <td class="num">{{ review.flags | length }}</td>
    <td class="num">{% if review.failed_checks() %}<span class="tag failed">{{ review.failed_checks() | length }}</span>{% else %}0{% endif %}</td>
    <td>{{ review.extraction.extractor }}</td>
  </tr>
  {% endfor %}
  </tbody>
</table>

<h2>Judgments raised across the run</h2>
<table>
  <thead><tr><th>Contract</th><th>Step</th><th>Matter</th>{% if conclusions %}<th>Status</th>{% endif %}</tr></thead>
  <tbody>
  {% for review in reviews %}
  {% for flag in review.flags_in_review_order() %}
  <tr>
    <td><a href="{{ review.doc_id }}.html">{{ review.doc_id }}</a></td>
    <td>{{ flag.step }}</td>
    <td>{{ flag.judgment_type.value.replace('_', ' ') }}</td>
    {% if conclusions %}
    {% set conclusion = conclusions.for_flag(review.doc_id, flag) %}
    {% if conclusion %}
    <td><span class="tag concluded">concluded</span> by {{ conclusion.reviewer }} on {{ conclusion.date }}</td>
    {% else %}
    <td><span class="tag open">open</span></td>
    {% endif %}
    {% endif %}
  </tr>
  {% endfor %}
  {% endfor %}
  </tbody>
</table>
{% endblock %}
